{
  "name": "no-human-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Desktop shell for the no_human board — attaches to (or launches) the local nh server and wraps it in a native window.",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "desktop": "electron .",
    "test": "node --test",
    "dist": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:dir": "electron-builder --config electron-builder.config.cjs --mac dir --publish never",
    "dist:bundled": "bash ../packaging/build-installer.sh && electron-builder --config electron-builder.config.cjs --mac --publish never && bash ../packaging/make-dmg.sh"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "files": [
      "main.mjs",
      "server.mjs",
      "preload.cjs",
      "tokenStore.mjs",
      "setupUi.mjs",
      "navScheduler.mjs",
      "setupGate.mjs",
      "serverOwnership.mjs",
      "serverLifecycle.mjs",
      "quitPolicy.mjs",
      "badge.mjs",
      "menu.mjs",
      "updater.mjs",
      "updatePolicy.mjs",
      "updateState.mjs",
      "themeState.mjs",
      "error.html",
      "token.html",
      "package.json"
    ]
  },
  "overrides": {
    "@noble/hashes": "^1.5.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
