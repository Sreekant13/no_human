@@ -1,4 +1,6 @@
-from parcelo.rates import quote
+import pytest
+
+from parcelo.rates import quote, volumetric_weight_kg
 
 
 def test_quote_within_one_zone():
@@ -15,3 +17,49 @@ def test_quote_cross_zone_c_standard():
 
 def test_quote_express_within_one_zone():
     assert quote(2.0, "EC1A 1BB", "WC2N 5DU", express=True) == 8.10
+
+
+def test_quote_accepts_dimensions_in_cm():
+    result = quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=60, width_cm=50, height_cm=40)
+    assert isinstance(result, float)
+
+
+def test_bulky_parcel_bills_on_volumetric_weight():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=60, width_cm=50, height_cm=40) == 29.60
+
+
+def test_dense_parcel_still_bills_on_actual_weight():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=10, width_cm=10, height_cm=10) == 5.40
+
+
+def test_quote_without_dimensions_is_unchanged():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU") == 5.40
+    assert quote(2.0, "EC1A 1BB", "SW1A 2AA") == 6.90
+    assert quote(2.0, "EC1A 1BB", "AB10 1AA") == 8.40
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", express=True) == 8.10
+
+
+def test_volumetric_weight_kg_formula():
+    assert volumetric_weight_kg(60, 50, 40) == 24.0
+    assert volumetric_weight_kg(10, 10, 10) == pytest.approx(0.2)
+
+
+def test_partial_dimensions_are_rejected():
+    with pytest.raises(ValueError):
+        quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=60, width_cm=50)
+
+
+def test_non_positive_dimensions_are_rejected():
+    with pytest.raises(ValueError):
+        quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=60, width_cm=50, height_cm=0)
+    with pytest.raises(ValueError):
+        quote(2.0, "EC1A 1BB", "WC2N 5DU", length_cm=60, width_cm=50, height_cm=-5)
+
+
+def test_volumetric_applies_with_express_and_surcharge():
+    weight_cost = round(1.10 * volumetric_weight_kg(60, 50, 40), 2)
+    surcharge = 1.50
+    total = 3.20 + weight_cost + surcharge
+    expected = round(total * 1.5 + surcharge, 2)
+    assert quote(2.0, "EC1A 1BB", "SW1A 2AA", express=True,
+                 length_cm=60, width_cm=50, height_cm=40) == expected
