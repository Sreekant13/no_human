diff --git a/parcelo/rates.py b/parcelo/rates.py
index cc69236..fc55a4d 100644
--- a/parcelo/rates.py
+++ b/parcelo/rates.py
@@ -5,13 +5,43 @@ from parcelo.zones import surcharge_for, zone_for
 BASE_FEE = 3.20
 PER_KG = 1.10
 EXPRESS_MULTIPLIER = 1.5
+VOLUMETRIC_DIVISOR = 5000.0  # cm^3 per kg, per carrier contract
 
 
-def quote(weight_kg, origin, destination, express=False):
-    """The all-in price for a shipment."""
+def volumetric_weight_kg(length_cm, width_cm, height_cm):
+    """Carrier volumetric weight for a box, in kg."""
+    return length_cm * width_cm * height_cm / VOLUMETRIC_DIVISOR
+
+
+def _billable_weight_kg(weight_kg, length_cm, width_cm, height_cm):
+    dims = {"length_cm": length_cm, "width_cm": width_cm, "height_cm": height_cm}
+    given = {name: value for name, value in dims.items() if value is not None}
+    if not given:
+        return weight_kg
+    missing = [name for name in dims if name not in given]
+    if missing:
+        raise ValueError(
+            "all of length_cm, width_cm, height_cm must be given together; "
+            "missing: " + ", ".join(missing)
+        )
+    for name, value in given.items():
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
+            raise ValueError(name + " must be a positive number")
+    return max(weight_kg, volumetric_weight_kg(length_cm, width_cm, height_cm))
+
+
+def quote(weight_kg, origin, destination, express=False,
+          length_cm=None, width_cm=None, height_cm=None):
+    """The all-in price for a shipment.
+
+    Dimensions (length_cm, width_cm, height_cm) are optional and given in
+    centimetres. When supplied, billing uses the greater of actual weight
+    and volumetric weight (length x width x height / 5000).
+    """
     origin_zone = zone_for(origin)
     dest_zone = zone_for(destination)
-    weight_cost = round(PER_KG * weight_kg, 2)
+    billable_kg = _billable_weight_kg(weight_kg, length_cm, width_cm, height_cm)
+    weight_cost = round(PER_KG * billable_kg, 2)
     surcharge = surcharge_for(origin_zone, dest_zone)
     total = BASE_FEE + weight_cost + surcharge
     if express:
