diff --git a/parcelo/rates.py b/parcelo/rates.py
index cc69236..e88cfab 100644
--- a/parcelo/rates.py
+++ b/parcelo/rates.py
@@ -5,13 +5,30 @@ from parcelo.zones import surcharge_for, zone_for
 BASE_FEE = 3.20
 PER_KG = 1.10
 EXPRESS_MULTIPLIER = 1.5
+DIM_DIVISOR = 5000.0
 
 
-def quote(weight_kg, origin, destination, express=False):
-    """The all-in price for a shipment."""
+def volumetric_weight(dimensions_cm):
+    """Volumetric weight in kg for an (length, width, height) cm triple."""
+    length, width, height = dimensions_cm
+    return (length * width * height) / DIM_DIVISOR
+
+
+def quote(weight_kg, origin, destination, express=False, dimensions_cm=None):
+    """The all-in price for a shipment.
+
+    dimensions_cm is an optional (length, width, height) triple in
+    centimetres. When given, billing uses the greater of actual and
+    volumetric weight (volumetric = l * w * h / DIM_DIVISOR), matching
+    how our carrier bills us on bulky parcels. When omitted, billing
+    uses actual weight only, unchanged from before.
+    """
     origin_zone = zone_for(origin)
     dest_zone = zone_for(destination)
-    weight_cost = round(PER_KG * weight_kg, 2)
+    billed_weight = weight_kg
+    if dimensions_cm is not None:
+        billed_weight = max(weight_kg, volumetric_weight(dimensions_cm))
+    weight_cost = round(PER_KG * billed_weight, 2)
     surcharge = surcharge_for(origin_zone, dest_zone)
     total = BASE_FEE + weight_cost + surcharge
     if express:
diff --git a/tests/test_rates.py b/tests/test_rates.py
