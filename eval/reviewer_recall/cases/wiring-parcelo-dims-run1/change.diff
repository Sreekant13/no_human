--- a/tests/test_rates.py
+++ b/tests/test_rates.py
@@ -1,4 +1,4 @@
-from parcelo.rates import quote
+from parcelo.rates import quote, volumetric_weight
 
 
 def test_quote_within_one_zone():
@@ -15,3 +15,34 @@ def test_quote_cross_zone_c_standard():
 
 def test_quote_express_within_one_zone():
     assert quote(2.0, "EC1A 1BB", "WC2N 5DU", express=True) == 8.10
+
+
+def test_volumetric_weight_formula():
+    assert volumetric_weight((100, 50, 40)) == 40.0
+
+
+def test_quote_accepts_dimensions():
+    result = quote(2.0, "EC1A 1BB", "WC2N 5DU", dimensions_cm=(50, 40, 30))
+    assert isinstance(result, float)
+
+
+def test_bulky_light_parcel_bills_volumetric_weight():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", dimensions_cm=(50, 40, 30)) == 16.40
+
+
+def test_dense_parcel_bills_actual_weight():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", dimensions_cm=(10, 10, 10)) == 5.40
+
+
+def test_volumetric_weight_applies_to_express():
+    result = quote(
+        2.0, "EC1A 1BB", "WC2N 5DU", express=True, dimensions_cm=(50, 40, 30)
+    )
+    assert result == 24.60
+
+
+def test_quote_without_dimensions_is_unchanged():
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU") == 5.40
+    assert quote(2.0, "EC1A 1BB", "SW1A 2AA") == 6.90
+    assert quote(2.0, "EC1A 1BB", "AB10 1AA") == 8.40
+    assert quote(2.0, "EC1A 1BB", "WC2N 5DU", express=True) == 8.10
