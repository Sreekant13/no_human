# Pin the public npm registry for this directory. See the repo-root .npmrc for
# the full reasoning; the short version is that a `registry=` line in a user's
# ~/.npmrc silently redirects every install, and npm reads the project config
# from the CURRENT directory only — it does NOT walk up to the repo root — so
# this file is what actually protects `web/package-lock.json`.
registry=https://registry.npmjs.org/
