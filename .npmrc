# Pin the public npm registry, at project level, so a user-level ~/.npmrc
# cannot decide where this repo's dependencies come from.
#
# WHY THIS FILE EXISTS. A `registry=` line in ~/.npmrc applies to every install
# that user ever runs. On this machine that line pointed at the operator's
# former employer's internal mirror, and a single `npm install` rewrote eight
# `resolved` URLs in package-lock.json to that host — committing an internal
# infrastructure hostname into a repo that is about to be published. Those URLs
# were reverted by hand; the CAUSE was not, because it lives outside the repo
# and re-applies on the next install, forever.
#
# npm config precedence is: CLI flag > env > PROJECT .npmrc > user ~/.npmrc >
# global > builtin, so this file wins. Measured on 2026-07-31, before and after:
#   $ npm config get registry   ->  <internal mirror>            (no .npmrc)
#   $ npm config get registry   ->  https://registry.npmjs.org/  (with it)
#
# ONE FILE PER npm DIRECTORY, deliberately. npm reads the project config from
# the CURRENT directory and does NOT walk up to a parent — verified the same
# day: with only this root file present, `npm config get registry` inside
# `web/` and `desktop/` still returned the internal mirror. So `web/.npmrc` and
# `desktop/.npmrc` are not redundant copies; they are the only ones that apply
# to the two directories that actually run npm. This root copy covers anyone
# who runs npm at the repo root.
#
# `tests/test_npm_registry.py` holds all three honest, and separately asserts
# that no lockfile references a non-public registry host.
registry=https://registry.npmjs.org/
